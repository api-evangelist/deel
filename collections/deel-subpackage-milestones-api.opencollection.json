{
  "opencollection": "1.0.0",
  "info": {
    "name": "Endpoints subpackage_milestones API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "subpackage_milestones",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Milestones by Contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/milestones",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Deel contract for which milestones are being retrieved."
              }
            ]
          },
          "docs": "Retrieve a list of milestones associated with a specific contract. Each milestone includes details such as its title, amount, status, and relevant dates, along with information about the creator and reviewer.\n **Token scopes**: `milestones:read`"
        },
        {
          "info": {
            "name": "Create a Milestone",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/milestones",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Deel contract where the milestone will be added."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new milestone to a specific contract. Milestones represent distinct deliverables or phases in the contract and can include additional details such as attachments.\n **Token scopes**: `milestones:write`"
        },
        {
          "info": {
            "name": "Retrieve a single milestone",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/milestones/:milestone_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "Deel contract id."
              },
              {
                "name": "milestone_id",
                "value": "",
                "type": "path",
                "description": "ID of milestone to return"
              }
            ]
          },
          "docs": "Retrieve a single milestone.\n **Token scopes**: `milestones:read`"
        },
        {
          "info": {
            "name": "Delete a Milestone",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/milestones/:milestone_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Deel contract from which the milestone will be deleted."
              },
              {
                "name": "milestone_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the milestone that is to be deleted."
              }
            ]
          },
          "docs": "Delete a specific milestone associated with a contract. This operation removes the milestone and its data permanently from the system.\n **Token scopes**: `milestones:write`"
        }
      ]
    }
  ],
  "bundled": true
}