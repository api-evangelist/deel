          "info": {
            "name": "List of off-cycle payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/off-cycle-payments",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier (ID) of the Deel contract for which to retrieve off-cycle payments."
              }
            ]
          },
          "docs": "Retrieve a list of off-cycle payments for the specified contract ID. Off-cycle payments are payments made outside the regular payment schedule, often for exceptional or one-time expenses.\n **Token scopes**: `off-cycle-payments:read`"
        },
        {
          "info": {
            "name": "Add off-cycle payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/off-cycle-payments",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier (ID) of the Deel contract for which the off-cycle payment is being created."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new invoice line-item for the purpose of an off-cycle payment associated with a specific contract. This is typically used for exceptional payments outside the regular payment schedule.\n **Token scopes**: `off-cycle-payments:write`"
        },
        {
          "info": {
            "name": "Retrieve a single off-cycle payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/off-cycle-payments/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
