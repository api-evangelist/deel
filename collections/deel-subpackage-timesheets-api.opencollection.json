            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "Deel contract id."
              },
              {
                "name": "contract_types",
                "value": "",
                "type": "query",
                "description": "Types of contracts to filter."
              },
              {
                "name": "statuses",
                "value": "",
