            "name": "List of timesheets by contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/timesheets",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
