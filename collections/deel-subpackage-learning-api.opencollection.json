{
  "opencollection": "1.0.0",
  "info": {
    "name": "Endpoints subpackage_learning API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "subpackage_learning",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve worker's actionable journeys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/engage/learning/actionable-journeys",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "journey_ids",
                "value": "",
                "type": "query",
                "description": "Filter by Journey IDs."
              },
              {
                "name": "journey_assignment_ids",
                "value": "",
                "type": "query",
                "description": "Filter by JourneyAssignment IDs."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Return a page of results with given number of records."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor to the next page of results. If not provided, the first page will be returned."
              }
            ]
          },
          "docs": "Return list of ActionableJourneys for a given Worker. The concept of Actionable Journeys in the Public API corresponds directly to what is labeled as Courses in the user interface. Learn more about [Learning Management](https://www.deel.com/hr/engage/learning-management-software/)\n **Token scopes**: `worker:read`"
        }
      ]
    }
  ],
  "bundled": true
}