          "name": "Fetch multiple EOR Contract forms",
          "request": {
            "name": "Fetch multiple EOR Contract forms",
            "description": {
              "content": "Retrieve paginated, versioned form definitions for creating EOR contracts for the specified countries. Use this endpoint when initializing or resuming a contract-creation flow to determine the required sections, fields, validation rules, and conditional logic per country (and optional contract type/locale). Always consume the latest effective version from the response and handle pagination. Not intended for reading or updating existing contracts.\n **Token scopes**: `forms:read`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forms",
                "eor",
                "create-contract",
                "definitions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of countries to return in a single response. Defaults to 10."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor for fetching subsequent pages of results."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"countries\": [\n      {\n        \"country_code\": \"<string>\",\n        \"state\": \"<string>\"\n      },\n      {\n        \"country_code\": \"<string>\",\n        \"state\": \"<string>\"\n      }\n    ],\n    \"start_date\": \"<date>\",\n    \"work_hours_per_week\": \"<integer>\",\n    \"contract_duration_in_days\": \"<integer>\"\n  }\n}",
